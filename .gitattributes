# Windows で clone してもコンテナ内で実行されるファイルを LF に保ちます。
#
# Git for Windows の既定は core.autocrlf=true です。この設定のまま .gitattributes が
# 無いと、チェックアウト時に .sh が CRLF へ変換されます。シェバンが "#!/bin/sh\r" と
# 解釈されるため、docker/php/entrypoint.sh は
#   exec /usr/local/bin/entrypoint.sh: no such file or directory
# で app コンテナが起動できなくなり、docker/mysql/initdb/*.sh も失敗します。
* text=auto eol=lf

# コンテナが直接読む・実行するファイルは明示的に LF を強制します。
*.sh            text eol=lf
Dockerfile      text eol=lf
*.ini           text eol=lf
*.conf          text eol=lf
*.sql           text eol=lf
*.yml           text eol=lf

# バイナリは変換対象から外します。
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
