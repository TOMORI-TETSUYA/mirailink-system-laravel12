APP_NAME="MiraiLink"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja

APP_PORT=8080
APP_UID=1000
APP_GID=1000

# 仕様書 1.0 のバージョン指定。タグが取得できない場合はここで差し替えます。
PHP_IMAGE=php:8.4.23-fpm-bookworm
MYSQL_IMAGE=mysql:8.4.10
NGINX_IMAGE=nginx:1.28.3-alpine

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=mirailink
DB_USERNAME=mirailink_app
DB_PASSWORD=CHANGE_TO_LONG_RANDOM_PASSWORD
DB_ROOT_PASSWORD=CHANGE_TO_DIFFERENT_LONG_RANDOM_PASSWORD

# phpMyAdmin（MySQL 管理 UI）
# 127.0.0.1 のみに公開されます。http://localhost:8081
PMA_IMAGE=phpmyadmin:5.2.3-apache
PMA_PORT=8081
# ログイン Cookie の暗号化鍵。未設定だと起動ごとにランダム生成されるため固定します。
# 生成例: openssl rand -base64 48 | cut -c1-32
PMA_BLOWFISH_SECRET=CHANGE_TO_RANDOM_32_CHARS
# SQL インポート時の上限。
PMA_UPLOAD_LIMIT=256M
PMA_MEMORY_LIMIT=512M
PMA_MAX_EXECUTION_TIME=600

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# 電話番号・メールの完全一致検索用HMAC鍵。APP_KEYとは必ず別の値にします。
CUSTOMER_SEARCH_HMAC_KEY=CHANGE_TO_SEPARATE_RANDOM_SECRET

# 顧客情報の保存期間（年）。固定値をソースコードへ埋め込まず、設定画面で上書きできます。
CUSTOMER_RETENTION_YEARS=
